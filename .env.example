# 复制为 .env 后按需修改；以下均为本地演示用的非敏感示例值

# MySQL
MYSQL_DATABASE=mockstudio
MYSQL_USER=mockstudio
MYSQL_PASSWORD=mockstudio
MYSQL_ROOT_PASSWORD=rootpass

# 端口
FRONTEND_PORT=3000
BACKEND_PORT=8080

# 演示账号 alice@demo.local / bob@demo.local 的密码
DEMO_USERS_ENABLED=true
DEMO_USER_PASSWORD=demo1234

# 开发接口 /api/dev/simulation（调整模拟耗时、指定失败阶段）
DEV_API_ENABLED=true

# 模拟耗时（毫秒）与启动时默认失败阶段（ASSET_CHECK / GENERATE / FINALIZE，留空 = 不失败）
SIM_DELAY_ASSET_CHECK_MS=1500
SIM_DELAY_GENERATE_MS=4000
SIM_DELAY_FINALIZE_MS=1500
SIM_FAIL_STAGE=

# 构建时的依赖镜像源（可选）。国内网络下载慢时取消下面两行的注释
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com
